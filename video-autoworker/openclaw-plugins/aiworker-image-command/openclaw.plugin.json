{
  "id": "aiworker-image-command",
  "name": "AI-worker Image Command",
  "version": "0.5.1",
  "description": "Action-specific protected-cover and image task commands for one explicitly bound OpenClaw agent and one shared image service.",
  "activation": { "onStartup": true, "onCapabilities": ["tool"] },
  "contracts": { "tools": [
    "aiworker_submit_creative_image",
    "aiworker_submit_designed_cover",
    "aiworker_submit_protected_cover",
    "aiworker_image_task",
    "aiworker_image_help",
    "aiworker_video_cover_frames",
    "aiworker_submit_protected_cover_from_frame"
  ] },
  "toolMetadata": {
    "aiworker_submit_creative_image": { "optional": true },
    "aiworker_submit_designed_cover": { "optional": true },
    "aiworker_submit_protected_cover": { "optional": true },
    "aiworker_image_task": { "optional": true },
    "aiworker_image_help": { "optional": true },
    "aiworker_video_cover_frames": { "optional": true },
    "aiworker_submit_protected_cover_from_frame": { "optional": true }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "releaseReady": { "type": "boolean" },
      "targetAgentId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
    }
  }
}
