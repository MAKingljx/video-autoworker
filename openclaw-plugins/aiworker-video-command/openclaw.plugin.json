{
  "id": "aiworker-video-command",
  "name": "AI-worker Video Command",
  "version": "0.5.3",
  "description": "Handles eligible video-learning messages and exposes the direct task-chain tool.",
  "activation": {
    "onStartup": true,
    "onCapabilities": [
      "hook",
      "tool"
    ]
  },
  "contracts": {
    "tools": [
      "aiworker_analyze_video"
    ]
  },
  "toolMetadata": {
    "aiworker_analyze_video": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "releaseReady": {
        "type": "boolean"
      },
      "allowedSenderSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
