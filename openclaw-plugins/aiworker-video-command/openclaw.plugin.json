{
  "id": "aiworker-video-command",
  "name": "AI-worker Video Command",
  "version": "0.5.0",
  "description": "Classifies eligible video-learning messages once with Qwen, then owns dispatch or status handling.",
  "activation": {
    "onStartup": true,
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "allowedSenderSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "releaseReady": {
          "type": "boolean"
        }
    }
  }
}
