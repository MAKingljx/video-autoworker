{
  "id": "aiworker-video-command",
  "name": "AI-worker Video Command",
  "description": "Handles video requests and bounded task status queries before model dispatch.",
  "activation": {
    "onStartup": true,
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "allowedSenderSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
