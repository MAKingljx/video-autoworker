#!/bin/sh
set +e

PID_FILE="$HOME/ai-worker/run/kimi-mlx-ring.pid"
LOG_FILE="$HOME/ai-worker/logs/kimi-mlx-ring.log"
PORT=18080

printf "node=%s user=%s\n" "$(hostname 2>/dev/null)" "$(whoami 2>/dev/null)"
printf "server_port=%s\n" "$PORT"

if [ -s "$PID_FILE" ]; then
  pid="$(cat "$PID_FILE")"
  if kill -0 "$pid" 2>/dev/null; then
    printf "launcher=running pid=%s\n" "$pid"
  else
    printf "launcher=stale pid=%s\n" "$pid"
  fi
else
  printf "launcher=not-running\n"
fi

printf "rank0_listen=%s\n" "$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')"
echo "local_processes:"
pgrep -af 'mlx_lm.server|mlx.launch' || true

echo "peer_processes:"
ssh aiworker-node1-tb "pgrep -af 'mlx_lm.server|mlx.launch' || true" 2>/dev/null || true

if [ -f "$LOG_FILE" ]; then
  printf "log=%s\n" "$LOG_FILE"
  tail -n 60 "$LOG_FILE"
fi
