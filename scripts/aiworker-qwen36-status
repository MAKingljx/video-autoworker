#!/bin/sh
set +e

LABEL="ai.aiworker.qwen36-server"
NAME="${QWEN36_NAME:-qwen36-35b-a3b-q8}"
PORT="${QWEN36_PORT:-18091}"
PID_FILE="$HOME/ai-worker/run/$NAME.pid"
LOG_FILE="$HOME/ai-worker/logs/qwen36-server.launchd.log"
ERR_FILE="$HOME/ai-worker/logs/qwen36-server.launchd.err"
MODEL_FILE="${QWEN36_MODEL_FILE:-$HOME/models/Qwen3.6-35B-A3B-FP8-GGUF/qwen36-35b-a3b-fp8-q8_0.gguf}"
MMPROJ_FILE="${QWEN36_MMPROJ_FILE:-$HOME/models/Qwen3.6-35B-A3B-FP8-GGUF/mmproj-qwen36-35b-a3b-fp8-f16.gguf}"
UID_NUM="$(id -u)"
DOMAIN="gui/$UID_NUM"

printf "node=%s user=%s\n" "$(hostname 2>/dev/null)" "$(whoami 2>/dev/null)"
printf "server_port=%s\n" "$PORT"
printf "model_file=%s\n" "$MODEL_FILE"
printf "mmproj_file=%s\n" "$MMPROJ_FILE"

if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
  printf "supervisor=loaded label=%s\n" "$LABEL"
  launchctl list | grep "$LABEL" || true
else
  printf "supervisor=not-loaded label=%s\n" "$LABEL"
fi

if [ -s "$PID_FILE" ]; then
  pid="$(cat "$PID_FILE")"
  if kill -0 "$pid" 2>/dev/null; then
    printf "server=running pid=%s\n" "$pid"
    ps -o pid,ppid,etime,stat,%cpu,%mem,rss,command -p "$pid" || true
  else
    printf "server=stale pid=%s\n" "$pid"
  fi
else
  printf "server=not-running\n"
fi

printf "listen=%s\n" "$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | tail -n +2 | wc -l | tr -d " ")"
ls -lh "$MODEL_FILE" "$MMPROJ_FILE" 2>/dev/null || true

echo "processes:"
pgrep -af "llama-server.*$PORT|llama-server.*Qwen3.6|aiworker-qwen36-server" || true

if command -v curl >/dev/null 2>&1; then
  code="$(curl -sS --max-time 3 -o /dev/null -w "%{http_code}" "http://127.0.0.1:$PORT/v1/models" 2>/dev/null)"
  printf "models_http=%s\n" "${code:-000}"
fi

if [ -f "$LOG_FILE" ]; then
  printf "log=%s\n" "$LOG_FILE"
  tail -n 80 "$LOG_FILE"
fi
if [ -s "$ERR_FILE" ]; then
  printf "err=%s\n" "$ERR_FILE"
  tail -n 40 "$ERR_FILE"
fi
