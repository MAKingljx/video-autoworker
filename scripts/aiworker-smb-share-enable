#!/bin/sh
set -eu

STORAGE_DIR="${AIWORKER_STORAGE_DIR:-/Users/Shared/aiworker-storage}"
MODELS_DIR="${AIWORKER_MODELS_DIR:-/Users/heisenbergs-1/models}"
STORAGE_SHARE="${AIWORKER_STORAGE_SHARE:-AIWorkerStorage}"
MODELS_SHARE="${AIWORKER_MODELS_SHARE:-AIWorkerModelsRO}"
OWNER="${AIWORKER_STORAGE_OWNER:-heisenbergs-1}"
GROUP="${AIWORKER_STORAGE_GROUP:-staff}"

if [ "$(id -u)" -ne 0 ]; then
  echo "Run this script with sudo on heisenbergs-1." >&2
  exit 1
fi

if [ ! -d "$MODELS_DIR" ]; then
  echo "Models directory does not exist: $MODELS_DIR" >&2
  exit 1
fi

/usr/bin/install -d -o "$OWNER" -g "$GROUP" -m 0770 "$STORAGE_DIR"

/usr/sbin/sharing -r "$STORAGE_SHARE" >/dev/null 2>&1 || true
/usr/sbin/sharing -r "$MODELS_SHARE" >/dev/null 2>&1 || true

/usr/sbin/sharing -a "$STORAGE_DIR" -n "$STORAGE_SHARE" -S "$STORAGE_SHARE" -s 001 -g 000 -R 0 -E 1
/usr/sbin/sharing -a "$MODELS_DIR" -n "$MODELS_SHARE" -S "$MODELS_SHARE" -s 001 -g 000 -R 1 -E 1

/bin/launchctl enable system/com.apple.smbd >/dev/null 2>&1 || true
/bin/launchctl bootstrap system /System/Library/LaunchDaemons/com.apple.smbd.plist >/dev/null 2>&1 || true
/bin/launchctl kickstart -k system/com.apple.smbd >/dev/null 2>&1 || true

echo "SMB sharepoints:"
/usr/sbin/sharing -l
echo
echo "SMB listener:"
/usr/bin/nc -vz -w 3 127.0.0.1 445
