#!/bin/sh
set +e

PID_FILE="$HOME/ai-worker/run/deepseek-v4-flash-bf16.pid"
LOG_FILE="$HOME/ai-worker/logs/deepseek-v4-flash-bf16-mlx.log"
MODEL_DIR="${DEEPSEEK_MODEL_DIR:-$HOME/models/DeepSeek-V4-Flash-bf16}"
PORT="${DEEPSEEK_PORT:-18082}"

printf "node=%s user=%s\n" "$(hostname 2>/dev/null)" "$(whoami 2>/dev/null)"
printf "server_port=%s\n" "$PORT"
printf "model_dir=%s\n" "$MODEL_DIR"

if [ -s "$PID_FILE" ]; then
  pid="$(cat "$PID_FILE")"
  if kill -0 "$pid" 2>/dev/null; then
    printf "server=running pid=%s\n" "$pid"
  else
    printf "server=stale pid=%s\n" "$pid"
  fi
else
  printf "server=not-running\n"
fi

printf "listen=%s\n" "$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')"
printf "shards=%s\n" "$(find "$MODEL_DIR" -maxdepth 1 -name 'model-*.safetensors' -type f 2>/dev/null | wc -l | tr -d ' ')"
du -sh "$MODEL_DIR" 2>/dev/null || true

echo "processes:"
pgrep -af 'mlx_lm.*DeepSeek-V4-Flash-bf16|mlx_lm server' || true

if [ -f "$LOG_FILE" ]; then
  printf "log=%s\n" "$LOG_FILE"
  tail -n 80 "$LOG_FILE"
fi
