#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--version" ]]; then
  echo "openclaw 2026.3.2"
  exit 0
fi

if [[ "${1:-}" == "gateway" && "${2:-}" == "call" && "${3:-}" == "sessions.list" ]]; then
  if [[ "${E2E_GATEWAY_EXPECTED:-0}" != "1" ]]; then
    echo "openclaw mock: sessions.list requires gateway mode" >&2
    exit 0
  fi

  params=""
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--params" && $# -gt 1 ]]; then
      params="$2"
      break
    fi
    shift
  done

  case "$params" in
    '{"limit":200,"offset":0,"configuredAgentsOnly":true}')
      cat <<'JSON'
{"sessions":[{"key":"agent:engineering-bot:main","agentId":"engineering-bot","sessionId":"sess-eng-main","updatedAt":4102444800000,"kind":"dm","channel":"engineering","model":"openai/gpt-5","totalTokens":24500,"inputTokens":16100,"outputTokens":8400,"contextTokens":120000,"hasActiveRun":true}],"hasMore":true,"nextOffset":1}
JSON
      ;;
    '{"limit":200,"offset":1,"configuredAgentsOnly":true}')
      cat <<'JSON'
{"sessions":[{"key":"agent:research-bot:main","agentId":"research-bot","sessionId":"sess-research-main","updatedAt":4102444740000,"kind":"dm","channel":"research","model":"anthropic/claude-sonnet-4-5","totalTokens":12000,"inputTokens":8000,"outputTokens":4000,"contextTokens":64000,"hasActiveRun":false}],"hasMore":false}
JSON
      ;;
    *)
      echo "openclaw mock: unexpected sessions.list params: $params" >&2
      exit 2
      ;;
  esac
  exit 0
fi

if [[ "${1:-}" == "-c" ]]; then
  cmd="${2:-}"
  if [[ "$cmd" == sessions_spawn* ]]; then
    echo "Session created: mock-openclaw-session"
    exit 0
  fi
  echo "ok"
  exit 0
fi

echo "openclaw mock: unsupported args: $*" >&2
exit 0
