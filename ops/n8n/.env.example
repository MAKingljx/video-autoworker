# This file is a shell-compatible template. The installer copies it to the
# external path selected by AIWORKER_N8N_ENV_FILE and generates the key there.

# Node 22.22+ runtime. Override this when Node lives elsewhere.
N8N_NODE_BIN="$HOME/ai-worker/node/current/bin/node"
N8N_NPM_BIN="$HOME/ai-worker/node/current/bin/npm"

# Repository-external runtime locations. Never point these into the Git tree.
AIWORKER_N8N_RUNTIME_ROOT="$HOME/ai-worker/services/video-autoworker-n8n"
N8N_USER_FOLDER="$HOME/ai-worker/state/n8n"
AIWORKER_N8N_LOG_DIR="$HOME/ai-worker/logs/n8n"
AIWORKER_N8N_RUN_DIR="$HOME/ai-worker/run/n8n"
AIWORKER_N8N_BACKUP_DIR="$HOME/ai-worker/backups/n8n"

# Loopback-only production endpoint consumed by Video AutoWorker.
N8N_LISTEN_ADDRESS="127.0.0.1"
N8N_HOST="127.0.0.1"
N8N_PORT="5678"
N8N_PROTOCOL="http"
N8N_EDITOR_BASE_URL="http://127.0.0.1:5678"
N8N_WEBHOOK_URL="http://127.0.0.1:5678/"
N8N_SECURE_COOKIE="false"

# The installer writes a random 256-bit value to the external env file.
# Never commit the generated value or change it after credentials are created.
N8N_ENCRYPTION_KEY=

# Keep runtime telemetry and hosted templates out of the local control plane.
N8N_DIAGNOSTICS_ENABLED="false"
N8N_VERSION_NOTIFICATIONS_ENABLED="false"
N8N_TEMPLATES_ENABLED="false"
N8N_PERSONALIZATION_ENABLED="false"
N8N_METRICS="false"

# Retain enough local execution history for diagnosis without unbounded growth.
EXECUTIONS_DATA_PRUNE="true"
EXECUTIONS_DATA_MAX_AGE="336"
DB_SQLITE_POOL_SIZE="2"

# Local security and timezone defaults.
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS="true"
N8N_BLOCK_ENV_ACCESS_IN_NODE="true"
N8N_PUBLIC_API_DISABLED="false"
GENERIC_TIMEZONE="Asia/Shanghai"
TZ="Asia/Shanghai"

# Optional: create an API key in the n8n UI and copy it only to the external
# Video AutoWorker service environment. Do not add it to this tracked template.
# N8N_API_KEY=
