{
  "version": 1,
  "routes": [
    {
      "id": "local-qwen36",
      "label": "本地千问 3.6",
      "description": "通过 qwen-current OpenClaw 配置档调用本机千问，适合私密资料和工具执行。",
      "location": "local",
      "transport": "openclaw",
      "model": "qwen36-tools-local/default_model",
      "profile": "qwen-current",
      "agentId": "second-original",
      "thinking": "off",
      "timeoutSeconds": 300,
      "capabilities": ["text", "vision", "tools", "structured-output"],
      "enabled": true
    },
    {
      "id": "cloud-gpt-main",
      "label": "云端 GPT 主模型",
      "description": "通过 gpt-main OpenClaw 配置档调用云端模型，适合规划和审核。",
      "location": "cloud",
      "transport": "openclaw",
      "model": "openai/gpt-5.5",
      "profile": "gpt-main",
      "agentId": "main",
      "thinking": "high",
      "timeoutSeconds": 300,
      "capabilities": ["text", "vision", "tools", "reasoning", "structured-output"],
      "enabled": true
    },
    {
      "id": "cloud-qwen37-plus",
      "label": "通义千问 3.7 Plus API",
      "description": "百炼 OpenAI 兼容 API 示例；启用前把 DASHSCOPE_API_KEY 放入外部环境。",
      "location": "cloud",
      "transport": "openai-compatible",
      "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "apiKeyEnv": "DASHSCOPE_API_KEY",
      "model": "qwen3.7-plus",
      "timeoutSeconds": 300,
      "maxTokens": 32768,
      "capabilities": ["text", "vision", "reasoning", "structured-output"],
      "enabled": false
    },
    {
      "id": "cloud-qwen37-max",
      "label": "通义千问 3.7 Max API",
      "description": "百炼旗舰模型示例；启用前把 DASHSCOPE_API_KEY 放入外部环境。",
      "location": "cloud",
      "transport": "openai-compatible",
      "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "apiKeyEnv": "DASHSCOPE_API_KEY",
      "model": "qwen3.7-max",
      "timeoutSeconds": 300,
      "maxTokens": 32768,
      "capabilities": ["text", "vision", "tools", "reasoning"],
      "enabled": false
    }
  ]
}
