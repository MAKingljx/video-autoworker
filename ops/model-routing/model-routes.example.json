{
  "version": 1,
  "resources": [
    {
      "id": "whisper-large-v3-turbo",
      "label": "Whisper large-v3-turbo",
      "description": "供 qwen-current 和 qwen-weixin-new 的语音消息按需转写。",
      "location": "local",
      "kind": "speech-recognition",
      "model": "large-v3-turbo",
      "production": true,
      "enabled": true,
      "capabilities": ["audio", "transcription", "multilingual"],
      "usedBy": [
        "qwen-current 语音消息转写",
        "qwen-weixin-new 语音消息转写"
      ],
      "runtime": {
        "type": "cli",
        "command": "~/ai-worker/bin/aiworker-whisper-transcribe",
        "requiredFiles": ["~/.cache/whisper/large-v3-turbo.pt"]
      }
    },
    {
      "id": "nomic-embed-text",
      "label": "nomic-embed-text",
      "description": "供 OpenClaw 长期记忆检索按需生成文本向量。",
      "location": "local",
      "kind": "embedding",
      "model": "nomic-embed-text",
      "production": true,
      "enabled": true,
      "capabilities": ["text", "embedding"],
      "usedBy": [
        "gpt-main 长期记忆检索",
        "qwen-current 长期记忆检索",
        "qwen-weixin-new 长期记忆检索"
      ],
      "runtime": {
        "type": "ollama",
        "baseUrl": "http://127.0.0.1:11434"
      }
    }
  ],
  "routes": [
    {
      "id": "local-qwen36-direct",
      "resourceId": "qwen36-local",
      "resourceLabel": "本地千问 3.6",
      "label": "本地千问 3.6 直连",
      "description": "由 n8n 模型节点直连本机 Qwen API，适合规划、执行和审核等无需 OpenClaw 工具的高速任务。",
      "location": "local",
      "transport": "openai-compatible",
      "baseUrl": "http://127.0.0.1:18091/v1",
      "model": "default_model",
      "timeoutSeconds": 180,
      "temperature": 0,
      "maxTokens": 32768,
      "capabilities": ["text", "reasoning", "structured-output"],
      "enabled": true
    },
    {
      "id": "local-qwen36",
      "resourceId": "qwen36-local",
      "resourceLabel": "本地千问 3.6",
      "label": "本地千问 3.6 Agent",
      "description": "通过 qwen-current OpenClaw 配置档调用本机千问，仅用于需要 OpenClaw 工具或最终会话回投的节点。",
      "location": "local",
      "transport": "openclaw",
      "model": "qwen36-tools-local/default_model",
      "profile": "qwen-current",
      "agentId": "second-original",
      "thinking": "off",
      "timeoutSeconds": 300,
      "capabilities": ["text", "vision", "tools", "structured-output"],
      "enabled": true
    },
    {
      "id": "cloud-gpt-main",
      "resourceId": "gpt-main-cloud",
      "resourceLabel": "云端 GPT 主模型",
      "label": "云端 GPT 主模型",
      "description": "通过 gpt-main OpenClaw 配置档调用云端模型，适合规划和审核。",
      "location": "cloud",
      "transport": "openclaw",
      "model": "openai/gpt-5.5",
      "profile": "gpt-main",
      "agentId": "main",
      "thinking": "high",
      "timeoutSeconds": 300,
      "capabilities": ["text", "vision", "tools", "reasoning", "structured-output"],
      "enabled": true
    }
  ]
}
