        "type": "local-files",
        "directory": "~/.cache/huggingface/hub/models--BAAI--bge-m3/snapshots/5617a9f61b028005a4858fdac845db406aefb181",
        "requiredFiles": [
          "config.json",
          "modules.json",
          "pytorch_model.bin",
          "tokenizer.json"
        ]
      }
    },
    {
      "id": "qwen3-reranker-8b",
      "label": "Qwen3-Reranker-8B",
      "description": "已安装的 8B 检索重排模型，适合对候选结果精排；尚未接入生产检索链路。",
      "location": "local",
      "kind": "reranker",
      "model": "Qwen/Qwen3-Reranker-8B",
      "production": false,
      "enabled": true,
      "capabilities": ["text", "reranking", "multilingual"],
      "usedBy": [],
      "runtime": {
        "type": "local-files",
        "directory": "~/.cache/huggingface/hub/models--Qwen--Qwen3-Reranker-8B/snapshots/77d193c791ed757ca307ee72715aa132723da912",
        "requiredFiles": [
          "config.json",
