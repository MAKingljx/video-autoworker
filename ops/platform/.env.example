# External Video AutoWorker service environment.
# Copy to ~/.config/video-autoworker/platform.env with mode 0600.
# Never commit the real file or any values generated for it.

N8N_BASE_URL="http://127.0.0.1:5678"
N8N_DEFAULT_WEBHOOK_PATH="webhook/aiworker-task"
AIWORKER_MODEL_ROUTES_FILE="$HOME/.config/video-autoworker/model-routes.json"

# Stateless video-analysis runtime. These directories contain only managed
# inbox copies and short-lived preprocessing files, never OpenClaw memory.
AIWORKER_FFMPEG_BIN="$HOME/ai-worker/bin/ffmpeg"
AIWORKER_MEDIA_INGEST_DIR="$HOME/ai-worker/state/video-autoworker/media-inbox"
AIWORKER_MEDIA_WORK_DIR="$HOME/ai-worker/state/video-autoworker/media-tasks"

# Generate a random shared secret outside Git. The console sends it to the
# loopback-only n8n webhook, and n8n forwards it back to the internal execution
# callbacks under /api/n8n/.
N8N_WEBHOOK_SECRET=

# Create this in the n8n UI after owner setup. It is not required for webhook
# execution, but enables workflow and execution-history management APIs.
N8N_API_KEY=
