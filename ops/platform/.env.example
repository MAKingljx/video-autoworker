# External Video AutoWorker service environment.
# Copy to ~/.config/video-autoworker/platform.env with mode 0600.
# Never commit the real file or any values generated for it.

N8N_BASE_URL="http://127.0.0.1:5678"
N8N_DEFAULT_WEBHOOK_PATH="webhook/aiworker-task"

# Generate a random shared secret outside Git. The console sends it to the
# loopback-only n8n webhook, and n8n forwards it back to /api/n8n/execute.
N8N_WEBHOOK_SECRET=

# Create this in the n8n UI after owner setup. It is not required for webhook
# execution, but enables workflow and execution-history management APIs.
N8N_API_KEY=
